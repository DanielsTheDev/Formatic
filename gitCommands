# --- Configuración inicial (solo la primera vez en tu computador) ---
git config --global user.name "Tu Nombre"        # Tu nombre como autor de los commits
git config --global user.email "tu@correo.com"   # Usa el mismo correo de tu cuenta de GitHub

# --- Crear el repositorio local (desde la carpeta raíz del proyecto) ---
git init                 # Convierte la carpeta en repositorio (crea la carpeta oculta .git)
git branch -M main       # Renombra la rama principal a "main", el estándar de GitHub

# --- Primer commit ---
git add .                # Marca todos los archivos para guardarlos en el commit
git commit -m "Landing page de FormaTIC con footer"   # Guarda una "foto" del proyecto con un mensaje

# --- Conectar con GitHub y subir (primero crea un repo vacío en github.com, sin README) ---
git remote add origin https://github.com/TU_USUARIO/TU_REPO.git   # Define la dirección del repo remoto
git push -u origin main  # Sube la rama main; el -u recuerda la conexión para la próxima vez

# --- Flujo para los cambios siguientes ---
git status               # Muestra qué archivos cambiaron
git add .                # Marca los cambios
git commit -m "Describe lo que cambiaste"   # Guarda los cambios
git push                 # Sube los cambios a GitHub

# --- Comandos útiles ---
git log --oneline        # Muestra el historial de commits resumido
git pull                 # Descarga los cambios del remoto (úsalo antes de trabajar en equipo)